# 复制本文件为 .env 并填入真实 Key（.env 已被 .gitignore 忽略，不会提交）

# OpenAI 兼容接口（硅基流动 / DeepSeek / 通义等均可用）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 默认评测模型（硅基流动示例：deepseek-ai/DeepSeek-V3、Qwen/Qwen2.5-7B-Instruct）
DEFAULT_MODEL=deepseek-ai/DeepSeek-V3

# Judge 评分模型（LLM-as-Judge 用，可用更强模型）
JUDGE_MODEL=deepseek-ai/DeepSeek-V3

# Embedding 模型（语义相似度指标用）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
